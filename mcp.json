{
    "mcpServers": {
        "kb-server": {
            "url": "http://kb-server:9181/mcp"
        },
        "atlassian": {
            "command": "uvx",
            "args": [
                "mcp-atlassian-multi",
                "--multi-user",
                "--jira-url=https://fecredit.atlassian.net"
            ],
            "credential_mapping": {
                "email": "jira_email",
                "api_token": "jira_token"
            }
        }
    }
}